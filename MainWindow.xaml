<Window x:Class="ScreenOverlayApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="300"
        Height="300"
        Title="Overlay App"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="True"
        Topmost="True"
        Background="White">

    <StackPanel Margin="10">
        <TextBlock Text="Мониторы:" FontWeight="Bold"/>
        <ItemsControl x:Name="MonitorsList"/>

        <TextBlock Text="Хоткей:" Margin="0,10,0,0"/>
        <TextBox x:Name="HotkeyBox"
                 Width="200"
                 Padding="4,3"
                 IsReadOnly="True"
                 Cursor="Hand"
                 ToolTip="Кликните и нажмите новое сочетание"
                 PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                 GotFocus="HotkeyBox_GotFocus"
                 LostFocus="HotkeyBox_LostFocus"/>
        <TextBlock x:Name="HotkeyHint"
                   Text="Кликните и нажмите сочетание клавиш"
                   FontSize="11"
                   Foreground="Gray"
                   Margin="0,2,0,0"/>

        <CheckBox x:Name="AutoStartCheck"
                  Content="Автозапуск с Windows"
                  Margin="0,10,0,0"
                  Checked="OnSettingChanged"
                  Unchecked="OnSettingChanged"/>

        <Button Content="Переключить оверлей"
            Click="OnToggleClick"
            Margin="0,15,0,0"/>
    </StackPanel>

</Window>
