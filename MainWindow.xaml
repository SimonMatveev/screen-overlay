<Window x:Class="ScreenOverlayApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="300"
        Height="300"
        Title="Overlay App"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="True"
        Topmost="True"
        Background="White">

    <StackPanel Margin="10">
        <TextBlock Text="Monitors:" FontWeight="Bold"/>
        <ItemsControl x:Name="MonitorsList"/>

        <TextBlock Text="Hotkey:" Margin="0,10,0,0"/>
        <TextBox x:Name="HotkeyBox"
                 Width="200"
                 Padding="4,3"
                 IsReadOnly="True"
                 Cursor="Hand"
                 ToolTip="Click to select hotkey combination"
                 PreviewMouseLeftButtonDown="HotkeyBox_PreviewMouseLeftButtonDown"
                 PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                 GotFocus="HotkeyBox_GotFocus"
                 LostFocus="HotkeyBox_LostFocus"/>
        <TextBlock x:Name="HotkeyHint"
                   Text="Click to select hotkey combination"
                   FontSize="11"
                   Foreground="Gray" Width="278"
                   />

        <CheckBox x:Name="AutoStartCheck"
                  Content="Launch app on Windows startup"
                  Margin="0,10,0,0"
                  Checked="OnSettingChanged"
                  Unchecked="OnSettingChanged"/>

        <Button Content="Toggle overlay"
            Click="OnToggleClick"
            Margin="0,15,0,0"/>
    </StackPanel>

</Window>
